[Unit]
Description=tax server
After=network.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/tax/server
Environment=TAX_DB_PATH=/home/hermes/tax/data/tax.db
Environment=TAX_APNS_KEY_PATH=/home/hermes/tax/keys/AuthKey.p8
EnvironmentFile=-/home/hermes/tax/server/.env
ExecStart=/home/hermes/tax/server/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
