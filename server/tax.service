# TAX systemd unit template.
#
# Rendered by "scripts/deploy-config.sh render" from the private deployment
# configuration (see docs/LOCAL_CONFIGURATION.md). Never install this file
# unrendered: the deployment scripts refuse files that still contain
# placeholders.
[Unit]
Description=TAX server
After=network.target

[Service]
Type=simple
User=@TAX_DEPLOY_USER@
Group=@TAX_DEPLOY_GROUP@
WorkingDirectory=@TAX_DEPLOY_SERVER_DIR@
Environment="TAX_DB_PATH=@TAX_DEPLOY_DB_PATH@"
Environment="TAX_APNS_KEY_PATH=@TAX_DEPLOY_APNS_KEY_PATH@"
EnvironmentFile=-@TAX_DEPLOY_ENV_FILE@
ExecStart=@TAX_DEPLOY_VENV_DIR@/bin/uvicorn main:app --host 127.0.0.1 --port @TAX_DEPLOY_PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
