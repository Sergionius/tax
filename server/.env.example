# Backend runtime environment for the systemd unit or Docker Compose.
# Copy to server/.env on the server and fill in real values. TAX_API_KEY is
# required and must be a long random value; deployment refuses to continue
# when it is missing or empty.

TAX_API_KEY=replace_with_a_long_random_value
TAX_APNS_KEY_ID=your_key_id
TAX_APNS_TEAM_ID=your_team_id
# Must match the app bundle identifier the iOS app is signed with
# (TAX_APP_BUNDLE_IDENTIFIER from ios/Config/Local.xcconfig).
TAX_APNS_BUNDLE_ID=your.app.bundle.id
TAX_APNS_USE_SANDBOX=1

# Store agent context/logs in the task history database. Off by default: the
# backend stores empty strings instead and clears any stored content at
# startup. Push delivery is unaffected either way. Opt in with exactly 1.
TAX_STORE_AGENT_CONTENT=0

# Delete tasks older than this many days (created_at, UTC). Cleanup runs at
# startup and then hourly; device registrations are kept. Must be a positive
# integer; the service refuses to start otherwise.
TAX_TASK_RETENTION_DAYS=7
