# TAX deployment configuration contract (example values only).
#
# Copy this file to a private location, fill in real values, and keep it out
# of Git. Recommended private location: ~/.config/tax/deploy.env with mode
# 0600. Point TAX_DEPLOY_CONFIG at an alternative file to use another
# location. See docs/LOCAL_CONFIGURATION.md for the full contract.
#
# Never commit a filled-in file, print its contents, or log credentials.

# SSH destination for scripts/deploy-backend.sh ("user@host").
TAX_DEPLOY_HOST=deploy@tax.example.com

# Service user and group that run the systemd unit on the server.
TAX_DEPLOY_USER=deploy
TAX_DEPLOY_GROUP=deploy

# Absolute path to the TAX checkout on the server.
TAX_DEPLOY_PROJECT_DIR=/home/deploy/tax

# Public domain that terminates TLS in front of the backend.
TAX_DEPLOY_DOMAIN=tax.example.com

# Loopback port the backend listens on. systemd, the reverse proxy and the
# health check must use the same port.
TAX_DEPLOY_PORT=8000

# Absolute path to the SQLite database file.
TAX_DEPLOY_DB_PATH=/home/deploy/tax/data/tax.db

# Absolute path to the APNs signing key (.p8).
TAX_DEPLOY_APNS_KEY_PATH=/home/deploy/tax/keys/AuthKey.p8

# Absolute path to the backend environment file read by the systemd unit.
TAX_DEPLOY_ENV_FILE=/home/deploy/tax/server/.env
